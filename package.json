{
  "name": "markdown-wordcount-extension",
  "displayName": "Markdown Wordcount Extension",
  "description": "A simple way to count all uncommented words in a markdown document.",
  "publisher": "SamMain",
  "repository": {"type": "git", "url": "https://github.com/essem8006/markdown-wordcount-extension.git"},
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "markdown-wordcount-extension.helloWorld",
      "title": "Hello World"
    }]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.143.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
